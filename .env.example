# Google AdSense publisher ID (example: ca-pub-1234567890123456)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Responsive display ad unit IDs created in AdSense
NEXT_PUBLIC_ADSENSE_HOME_SLOT=
NEXT_PUBLIC_ADSENSE_PLAYER_SLOT=

# Optional comma-separated additions to the default HTTPS player allowlist.
NEXT_PUBLIC_ALLOWED_EMBED_HOSTS=
